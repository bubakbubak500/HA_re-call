# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
HA_RECALL_TOKEN=
HA_RECALL_TRANSPORT=http
HA_RECALL_NAMESPACES=home,technical
# Full OpenAI-compatible embeddings URL; no network call when unset.
HA_RECALL_EMBEDDING_URL=
HA_RECALL_EMBEDDING_MODEL=model2vec
HA_RECALL_EMBEDDING_KEY=
# Direct Python only: load already downloaded Model2Vec weights instead of HTTP.
# First install: uv sync --extra local-model
# HA_RECALL_MODEL_PATH=/absolute/path/to/existing/model
